/ {
    uScope@fffc0000 {
        compatible = "ucube_lkm";
        reg = <0xfffc0000 0x8000>;
        interrupts = <0 89 1>;
        interrupt-parent = <&gic>;
        clocks = <&zynqmp_clk 71>, <&zynqmp_clk 72>, <&zynqmp_clk 73>, <&zynqmp_clk 74>;
        clock-names = "pl0_ref", "pl1_ref", "pl2_ref", "pl3_ref";
        ucube,arch = "zynqmp";
        ucube,fclk-enable = <1 0 0 0>;   /* fclk0 on, fclk1-3 off */
    };
    debug_bridge@80000000 {
        compatible = "xlnx,xvc";
        reg = <0x0 0x80000000 0x0 0x10000>;
        clocks = <&zynqmp_clk 71>;
        status = "okay";
        clock-names = "s_axi_aclk";
    };
};\
